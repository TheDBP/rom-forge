From 031041ea8e34f1ac69f7e2e08c0334afe5ccc412 Mon Sep 17 00:00:00 2001
From: TheDBP <TheDBP@users.noreply.github.com>
Date: Thu, 3 Sep 2026 14:27:12 +0000
Subject: [PATCH] apps/fdroid: bundle F-Droid client + Privileged Extension
 (silent installs)

vendor/lineage/prebuilts/fdroid/{FDroid,FDroidPrivilegedExtension}/Android.mk (wildcard-guarded
PRESIGNED prebuilts) + permissions allowlist + guarded PRODUCT_PACKAGES/COPY_FILES in config/common.mk
(anchored away from firefox's EOF block). APKs fetched by the feature FETCH hook.
---
 config/common.mk                                |  9 +++++++++
 prebuilts/fdroid/FDroid/Android.mk              | 15 +++++++++++++++
 .../fdroid/FDroidPrivilegedExtension/Android.mk | 17 +++++++++++++++++
 ...permissions-org.fdroid.fdroid.privileged.xml |  9 +++++++++
 4 files changed, 50 insertions(+)
 create mode 100644 prebuilts/fdroid/FDroid/Android.mk
 create mode 100644 prebuilts/fdroid/FDroidPrivilegedExtension/Android.mk
 create mode 100644 prebuilts/fdroid/permissions/privapp-permissions-org.fdroid.fdroid.privileged.xml

diff --git a/config/common.mk b/config/common.mk
index 5265427..32f2376 100644
--- a/config/common.mk
+++ b/config/common.mk
@@ -82,6 +82,15 @@ PRODUCT_COPY_FILES += \
 PRODUCT_PACKAGES += \
     android.software.credentials.prebuilt.xml
 
+# apps/fdroid feature: F-Droid client + Privileged Extension (silent installs). Guarded on the fetched APK.
+ifneq ($(wildcard vendor/lineage/prebuilts/fdroid/FDroid/FDroid.apk),)
+PRODUCT_PACKAGES += \
+    FDroid \
+    FDroidPrivilegedExtension
+PRODUCT_COPY_FILES += \
+    vendor/lineage/prebuilts/fdroid/permissions/privapp-permissions-org.fdroid.fdroid.privileged.xml:$(TARGET_COPY_OUT_PRODUCT)/etc/permissions/privapp-permissions-org.fdroid.fdroid.privileged.xml
+endif
+
 # Enable wireless Xbox 360 controller support
 PRODUCT_COPY_FILES += \
     frameworks/base/data/keyboards/Vendor_045e_Product_028e.kl:$(TARGET_COPY_OUT_PRODUCT)/usr/keylayout/Vendor_045e_Product_0719.kl
diff --git a/prebuilts/fdroid/FDroid/Android.mk b/prebuilts/fdroid/FDroid/Android.mk
new file mode 100644
index 0000000..0c40ac0
--- /dev/null
+++ b/prebuilts/fdroid/FDroid/Android.mk
@@ -0,0 +1,19 @@
+LOCAL_PATH := $(call my-dir)
+# F-Droid client (org.fdroid.fdroid), PRESIGNED. APK fetched by the apps/fdroid feature (gitignored).
+ifneq ($(wildcard $(LOCAL_PATH)/FDroid.apk),)
+include $(CLEAR_VARS)
+LOCAL_MODULE := FDroid
+LOCAL_MODULE_TAGS := optional
+LOCAL_MODULE_CLASS := APPS
+LOCAL_MODULE_SUFFIX := $(COMMON_ANDROID_PACKAGE_SUFFIX)
+LOCAL_BUILT_MODULE_STEM := package.apk
+LOCAL_CERTIFICATE := PRESIGNED
+# APK manifests declare these as uses-library required=false; the build system must agree or
+# manifest_check.py fails the build (AOSP 12+). Declaring them keeps dexpreopt/AOT enabled,
+# unlike RELAX_USES_LIBRARY_CHECK / PRODUCT_BROKEN_VERIFY_USES_LIBRARIES.
+LOCAL_OPTIONAL_USES_LIBRARIES := androidx.window.extensions androidx.window.sidecar
+LOCAL_SRC_FILES := FDroid.apk
+LOCAL_PRODUCT_MODULE := true
+LOCAL_DEX_PREOPT := false
+include $(BUILD_PREBUILT)
+endif
diff --git a/prebuilts/fdroid/FDroidPrivilegedExtension/Android.mk b/prebuilts/fdroid/FDroidPrivilegedExtension/Android.mk
new file mode 100644
index 0000000..cb31fc2
--- /dev/null
+++ b/prebuilts/fdroid/FDroidPrivilegedExtension/Android.mk
@@ -0,0 +1,17 @@
+LOCAL_PATH := $(call my-dir)
+# F-Droid Privileged Extension (org.fdroid.fdroid.privileged) — privileged shim for silent installs.
+# PRESIGNED; paired with the privapp-permissions allowlist (../permissions/). APK fetched (gitignored).
+ifneq ($(wildcard $(LOCAL_PATH)/FDroidPrivilegedExtension.apk),)
+include $(CLEAR_VARS)
+LOCAL_MODULE := FDroidPrivilegedExtension
+LOCAL_MODULE_TAGS := optional
+LOCAL_MODULE_CLASS := APPS
+LOCAL_MODULE_SUFFIX := $(COMMON_ANDROID_PACKAGE_SUFFIX)
+LOCAL_BUILT_MODULE_STEM := package.apk
+LOCAL_CERTIFICATE := PRESIGNED
+LOCAL_SRC_FILES := FDroidPrivilegedExtension.apk
+LOCAL_PRIVILEGED_MODULE := true
+LOCAL_PRODUCT_MODULE := true
+LOCAL_DEX_PREOPT := false
+include $(BUILD_PREBUILT)
+endif
diff --git a/prebuilts/fdroid/permissions/privapp-permissions-org.fdroid.fdroid.privileged.xml b/prebuilts/fdroid/permissions/privapp-permissions-org.fdroid.fdroid.privileged.xml
new file mode 100644
index 0000000..e497d52
--- /dev/null
+++ b/prebuilts/fdroid/permissions/privapp-permissions-org.fdroid.fdroid.privileged.xml
@@ -0,0 +1,9 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Privileged-permission allowlist for the F-Droid Privileged Extension (install/remove packages
+     for the F-Droid client). Copied to /product/etc/permissions. -->
+<permissions>
+    <privapp-permissions package="org.fdroid.fdroid.privileged">
+        <permission name="android.permission.INSTALL_PACKAGES"/>
+        <permission name="android.permission.DELETE_PACKAGES"/>
+    </privapp-permissions>
+</permissions>
-- 
