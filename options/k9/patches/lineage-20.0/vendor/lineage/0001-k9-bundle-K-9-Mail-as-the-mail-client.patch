From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TheDBP <TheDBP@users.noreply.github.com>
Date: Mon, 14 Sep 2026 09:36:44 -0400
Subject: [PATCH] k9: bundle K-9 Mail as the mail client

vendor/lineage/prebuilts/k9 module, installed unmodified, plus a guarded PRODUCT_PACKAGES line in
config/common.mk. The APK is fetched by the k9 option's fetch.sh; the module is a no-op without it.
---
 config/common.mk        |  6 ++++++
 prebuilts/k9/.gitignore |  2 ++
 prebuilts/k9/Android.mk | 26 ++++++++++++++++++++++++++
 3 files changed, 34 insertions(+)
 create mode 100644 prebuilts/k9/.gitignore
 create mode 100644 prebuilts/k9/Android.mk

diff --git a/config/common.mk b/config/common.mk
index 985e611..37a64cc 100644
--- a/config/common.mk
+++ b/config/common.mk
@@ -174,6 +174,12 @@ PRODUCT_COPY_FILES += \
 PRODUCT_PACKAGES += \
     rsync
 
+# k9 option: K-9 Mail as the mail client. Guarded on the fetched APK so a build without the option
+# (no APK) is unaffected; require.sh fails the build if the option is on and the APK is missing.
+ifneq ($(wildcard vendor/lineage/prebuilts/k9/K9Mail.apk),)
+PRODUCT_PACKAGES += K9Mail
+endif
+
 # Storage manager
 PRODUCT_SYSTEM_DEFAULT_PROPERTIES += \
     ro.storage_manager.enabled=true
diff --git a/prebuilts/k9/.gitignore b/prebuilts/k9/.gitignore
new file mode 100644
index 0000000..f13f748
--- /dev/null
+++ b/prebuilts/k9/.gitignore
@@ -0,0 +1,2 @@
+# Fetched by the k9 option (forge/prebuilt/fetch-k9.sh); never committed.
+K9Mail.apk
diff --git a/prebuilts/k9/Android.mk b/prebuilts/k9/Android.mk
new file mode 100644
index 0000000..7fad2a8
--- /dev/null
+++ b/prebuilts/k9/Android.mk
@@ -0,0 +1,26 @@
+LOCAL_PATH := $(call my-dir)
+# K-9 Mail (com.fsck.k9), PRESIGNED with F-Droid's key. The APK is fetched and sha256-verified by
+# the k9 option's fetch.sh and is gitignored, never committed. Defined only when it is present; see
+# config/common.mk.
+ifneq ($(wildcard $(LOCAL_PATH)/K9Mail.apk),)
+include $(CLEAR_VARS)
+LOCAL_MODULE := K9Mail
+LOCAL_MODULE_TAGS := optional
+LOCAL_MODULE_CLASS := APPS
+LOCAL_MODULE_SUFFIX := $(COMMON_ANDROID_PACKAGE_SUFFIX)
+LOCAL_BUILT_MODULE_STEM := package.apk
+LOCAL_CERTIFICATE := PRESIGNED
+# Ship the APK byte for byte. Without LOCAL_SDK_VERSION the build takes the rewriting path and
+# uncompresses the embedded libraries and dex, which invalidates the whole-file v2 signature; with
+# targetSdk 35 PackageManager then rejects the package at boot scan, silently. Setting it selects
+# do_not_alter_apk: copy, then check only. K-9 ships its dex compressed, so that check needs the
+# build/make patch that makes it a warning (the option's require.sh verifies it is applied).
+LOCAL_SDK_VERSION := current
+# The manifest declares these as uses-library required=false; the build must agree or
+# manifest_check.py fails the build.
+LOCAL_OPTIONAL_USES_LIBRARIES := com.sec.android.app.multiwindow androidx.window.extensions androidx.window.sidecar
+LOCAL_SRC_FILES := K9Mail.apk
+LOCAL_PRODUCT_MODULE := true
+LOCAL_DEX_PREOPT := false
+include $(BUILD_PREBUILT)
+endif
-- 
