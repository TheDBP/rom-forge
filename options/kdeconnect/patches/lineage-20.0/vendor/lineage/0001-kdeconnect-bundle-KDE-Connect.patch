From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TheDBP <TheDBP@users.noreply.github.com>
Date: Tue, 15 Sep 2026 14:09:20 -0400
Subject: [PATCH] kdeconnect: bundle KDE Connect

vendor/lineage/prebuilts/kdeconnect module, installed unmodified, plus a guarded PRODUCT_PACKAGES
line in config/common.mk. The APK is fetched by the kdeconnect option's fetch.sh; the module is a
no-op without it.

---
 config/common.mk                |  6 ++++++
 prebuilts/kdeconnect/.gitignore |  2 ++
 prebuilts/kdeconnect/Android.mk | 26 ++++++++++++++++++++++++++
 3 files changed, 34 insertions(+)
 create mode 100644 prebuilts/kdeconnect/.gitignore
 create mode 100644 prebuilts/kdeconnect/Android.mk

diff --git a/config/common.mk b/config/common.mk
index 985e611c..10e2495d 100644
--- a/config/common.mk
+++ b/config/common.mk
@@ -170,6 +170,12 @@ PRODUCT_PACKAGES += \
 PRODUCT_COPY_FILES += \
     vendor/lineage/prebuilt/common/etc/init/init.openssh.rc:$(TARGET_COPY_OUT_PRODUCT)/etc/init/init.openssh.rc
 
+# kdeconnect option: KDE Connect (phone <-> desktop). Guarded on the fetched APK so a build without
+# the option (no APK) is unaffected; require.sh fails the build if the option is on and the APK is missing.
+ifneq ($(wildcard vendor/lineage/prebuilts/kdeconnect/KDEConnect.apk),)
+PRODUCT_PACKAGES += KDEConnect
+endif
+
 # rsync
 PRODUCT_PACKAGES += \
     rsync
diff --git a/prebuilts/kdeconnect/.gitignore b/prebuilts/kdeconnect/.gitignore
new file mode 100644
index 00000000..3076ad9f
--- /dev/null
+++ b/prebuilts/kdeconnect/.gitignore
@@ -0,0 +1,2 @@
+# Fetched by the kdeconnect option (forge/prebuilt/fetch-kdeconnect.sh); never committed.
+KDEConnect.apk
diff --git a/prebuilts/kdeconnect/Android.mk b/prebuilts/kdeconnect/Android.mk
new file mode 100644
index 00000000..71ed86c5
--- /dev/null
+++ b/prebuilts/kdeconnect/Android.mk
@@ -0,0 +1,26 @@
+LOCAL_PATH := $(call my-dir)
+# KDE Connect (org.kde.kdeconnect_tp), PRESIGNED with F-Droid's key. The APK is fetched and
+# sha256-verified by the kdeconnect option's fetch.sh and is gitignored, never committed. Defined
+# only when it is present; see config/common.mk.
+ifneq ($(wildcard $(LOCAL_PATH)/KDEConnect.apk),)
+include $(CLEAR_VARS)
+LOCAL_MODULE := KDEConnect
+LOCAL_MODULE_TAGS := optional
+LOCAL_MODULE_CLASS := APPS
+LOCAL_MODULE_SUFFIX := $(COMMON_ANDROID_PACKAGE_SUFFIX)
+LOCAL_BUILT_MODULE_STEM := package.apk
+LOCAL_CERTIFICATE := PRESIGNED
+# Ship the APK byte for byte. Without LOCAL_SDK_VERSION the build takes the rewriting path and
+# uncompresses the embedded dex, which invalidates the whole-file v2 signature; with targetSdk >= 30
+# PackageManager then rejects the package at boot scan, silently. Setting it selects
+# do_not_alter_apk: copy, then check only. KDE Connect ships its dex compressed, so that check needs
+# the build/make patch that makes it a warning (the option's require.sh verifies it is applied).
+LOCAL_SDK_VERSION := current
+# The manifest declares these as uses-library required=false; the build must agree or
+# manifest_check.py fails the build.
+LOCAL_OPTIONAL_USES_LIBRARIES := androidx.window.extensions androidx.window.sidecar org.apache.http.legacy
+LOCAL_SRC_FILES := KDEConnect.apk
+LOCAL_PRODUCT_MODULE := true
+LOCAL_DEX_PREOPT := false
+include $(BUILD_PREBUILT)
+endif
