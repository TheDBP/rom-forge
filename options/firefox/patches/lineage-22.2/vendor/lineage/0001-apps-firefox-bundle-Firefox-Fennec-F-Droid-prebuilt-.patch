From 45d26dc84badc38ceee00f1e7dbbde93ef584f84 Mon Sep 17 00:00:00 2001
From: TheDBP <TheDBP@users.noreply.github.com>
Date: Thu, 3 Sep 2026 14:17:23 +0000
Subject: [PATCH] apps/firefox: bundle Firefox (Fennec F-Droid) prebuilt,
 replace Jelly

vendor/lineage/prebuilts/firefox/Android.bp (android_app_import, installed unmodified, overrides
Jelly) + guarded PRODUCT_PACKAGES in config/common.mk. APK fetched by the feature FETCH hook.
---
 config/common.mk                 |  8 ++++++++
 prebuilts/firefox/Android.bp     | 33 ++++++++++++++++++++++++++++++++
 prebuilts/firefox/jni/Android.mk | 26 +++++++++++++++++++++++++
 3 files changed, 67 insertions(+)
 create mode 100644 prebuilts/firefox/Android.bp
 create mode 100644 prebuilts/firefox/jni/Android.mk

diff --git a/config/common.mk b/config/common.mk
index 5265427b..afc577b6 100644
--- a/config/common.mk
+++ b/config/common.mk
@@ -276,3 +276,11 @@ include vendor/lineage/config/version.mk
 
 -include $(WORKSPACE)/build_env/image-auto-bits.mk
 -include vendor/lineage/config/partner_gms.mk
+
+# apps/firefox feature: bundle Firefox (Fennec F-Droid), replacing Jelly. Guarded on the fetched APK
+# so a build without the feature (no APK) is unaffected.
+ifneq ($(wildcard vendor/lineage/prebuilts/firefox/Firefox.apk),)
+PRODUCT_PACKAGES += Firefox
+# The unpacked JNI libraries, one module each (prebuilts/firefox/jni/Android.mk).
+PRODUCT_PACKAGES += $(patsubst %.so,Firefox_jni_%,$(notdir $(wildcard vendor/lineage/prebuilts/firefox/lib/arm64-v8a/*.so)))
+endif
diff --git a/prebuilts/firefox/Android.bp b/prebuilts/firefox/Android.bp
new file mode 100644
index 00000000..c4058cc0
--- /dev/null
+++ b/prebuilts/firefox/Android.bp
@@ -0,0 +1,33 @@
+// Firefox (Fennec F-Droid) prebuilt browser. The APK is fetched by the firefox option into this
+// directory and is gitignored, never committed.
+//
+// preprocessed: true installs the APK byte for byte. It has to: BUILD_PREBUILT with
+// LOCAL_CERTIFICATE := PRESIGNED rewrites the archive, uncompressing every embedded .so, and an APK
+// Signature Scheme v2 signature covers the whole file. Fennec is mostly libxul.so, so the rewrite
+// took it from 127,545,689 bytes to 242,684,607 and this platform then refused it:
+//
+//   INSTALL_PARSE_FAILED_NO_CERTIFICATES: ....SF indicates the APK is signed using APK Signature
+//   Scheme v2, but no such signature was found. Signature stripped?
+//
+// PackageManager hits that during the boot scan and skips the package silently, so the build
+// succeeds and the browser is absent.
+//
+// skip_preprocessed_apk_checks is required because preprocessed otherwise asserts the APK already
+// has uncompressed JNI libs and dex. Fennec declares extractNativeLibs=true, so its compressed libs
+// are correct -- they are extracted at install -- and repacking them is not ours to do.
+//
+// The ether branches cannot use this: neither property exists on Android 13's android_app_import.
+// They ship the same APK through BUILD_PREBUILT and survive the rewrite, because 13's signature
+// verifier still accepts the v1 signature that remains. 15 does not.
+android_app_import {
+    name: "Firefox",
+    apk: "Firefox.apk",
+    presigned: true,
+    preprocessed: true,
+    skip_preprocessed_apk_checks: true,
+    product_specific: true,
+    overrides: ["Jelly"],
+    // enforce_uses_libs: false -- the build otherwise refuses any APK whose manifest <uses-library>
+    // tags it was not told about, and those change with every upstream release.
+    enforce_uses_libs: false,
+}
diff --git a/prebuilts/firefox/jni/Android.mk b/prebuilts/firefox/jni/Android.mk
new file mode 100644
index 00000000..94586ffe
--- /dev/null
+++ b/prebuilts/firefox/jni/Android.mk
@@ -0,0 +1,26 @@
+# Firefox JNI libraries. The APK is installed byte for byte (see ../Android.bp) and PackageManager
+# does not extract native libraries for a bundled app, so the libraries fetch-firefox.sh unpacked
+# into ../lib/arm64-v8a/ are installed beside the APK as app/Firefox/lib/arm64/. One Make module per
+# library: the build refuses ELF files in PRODUCT_COPY_FILES, and no Soong prebuilt type installs
+# under app/. common.mk adds the modules to PRODUCT_PACKAGES from the same wildcard.
+LOCAL_PATH := $(call my-dir)/..
+
+FIREFOX_JNI_LIBS := $(notdir $(wildcard $(LOCAL_PATH)/lib/arm64-v8a/*.so))
+
+define firefox-jni-module
+include $$(CLEAR_VARS)
+LOCAL_MODULE := Firefox_jni_$(1:.so=)
+LOCAL_MODULE_CLASS := SHARED_LIBRARIES
+LOCAL_MODULE_STEM := $(1:.so=)
+LOCAL_MODULE_SUFFIX := .so
+LOCAL_MODULE_TAGS := optional
+LOCAL_SRC_FILES := lib/arm64-v8a/$(1)
+LOCAL_MULTILIB := 64
+LOCAL_PRODUCT_MODULE := true
+LOCAL_MODULE_PATH := $$(TARGET_OUT_PRODUCT)/app/Firefox/lib/arm64
+LOCAL_STRIP_MODULE := false
+LOCAL_CHECK_ELF_FILES := false
+include $$(BUILD_PREBUILT)
+endef
+
+$(foreach lib,$(FIREFOX_JNI_LIBS),$(eval $(call firefox-jni-module,$(lib))))
-- 
